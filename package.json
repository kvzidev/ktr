{
  "name": "@kvzidev/ktr",
  "version": "0.0.1",
  "description": "Kev Tec Red (KTR) is an idempotent E2E web stack scaffolder and expander",
  "bin": {
    "ktr": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "check": "biome check --write .",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
  },
  "keywords": [
    "cli",
    "scaffolder",
    "monorepo",
    "pnpm",
    "turborepo",
    "astro",
    "hono",
    "kysely",
    "typescript"
  ],
  "author": "Kevin S. Zanzi (kvzidev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kvzidev/ktr.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.7",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
